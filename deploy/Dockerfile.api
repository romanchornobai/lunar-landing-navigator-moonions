# Backend: FastAPI area search. Keeps the repo layout (REPO_ROOT = /app) so the services find
# data/dem (mounted volume) and the ephemeris buffer in frontend/public/data/ephemerides.
FROM python:3.11-slim
WORKDIR /app
COPY backend/requirements.txt backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt
COPY backend/app backend/app
COPY frontend/public/data/ephemerides frontend/public/data/ephemerides
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--host", "0.0.0.0", "--port", "8000"]
